---
// Seletor de tema: dois botões grudados. O da esquerda alterna claro/escuro e
// mostra o ícone do que o clique vai fazer; o da direita devolve o tema para o
// do sistema. O estado real vive no <html data-tema> e no localStorage — quem
// aplica é o script inline do Base.astro, que roda antes da primeira pintura.
const sol = `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>`;
const lua = `<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>`;
const monitor = `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>`;
---

<div class="tema" role="group" aria-label="Tema">
  <button type="button" data-tema-alterna aria-label="Alternar entre claro e escuro">
    <svg class="i-para-claro" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={sol} />
    <svg class="i-para-escuro" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={lua} />
  </button>
  <button type="button" data-tema-sistema aria-pressed="false" aria-label="Usar o tema do sistema">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={monitor} />
  </button>
</div>
