---
// Seletor de tema. O estado real vive no <html data-tema> e no localStorage;
// aqui só ficam os três botões. Quem aplica é o script inline do Base.astro,
// que roda antes da primeira pintura para a página não piscar.
const opcoes = [
  {
    valor: "claro",
    label: "Claro",
    icone: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>`,
  },
  {
    valor: "escuro",
    label: "Escuro",
    icone: `<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>`,
  },
  {
    valor: "sistema",
    label: "Do sistema",
    icone: `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  },
];
---

<details class="tema">
  <summary aria-label="Mudar o tema">
    <svg class="i-claro" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={opcoes[0].icone} />
    <svg class="i-escuro" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={opcoes[1].icone} />
  </summary>
  <div class="tema-menu" role="radiogroup" aria-label="Tema">
    {opcoes.map((o) => (
      <button type="button" role="radio" aria-checked="false" data-tema-op={o.valor}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={o.icone} />
        {o.label}
      </button>
    ))}
  </div>
</details>
