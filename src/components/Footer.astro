---
import BrandMark from "./BrandMark.astro";
import { RECURSOS } from "../data/recursos";
import { INSTAGRAM, EMPRESA_MAE } from "../data/seo";
import { ENTRAR } from "../data/app";

const colunas = [
  {
    titulo: "O que ele faz",
    links: [
      ...RECURSOS.slice(0, 5).map((r) => ({ href: `/recursos/${r.slug}/`, label: r.titulo })),
      { href: "/recursos/", label: "Todos os recursos" },
    ],
  },
  {
    titulo: "Monnif",
    links: [
      { href: "/manifesto/", label: "Nossa história" },
      { href: "/indique/", label: "Indique e ganhe" },
      { href: "/seguranca/", label: "Seus dados" },
      { href: "/marca/", label: "Marca" },
      { href: "/#faq", label: "Dúvidas" },
    ],
  },
  {
    titulo: "Aprender",
    links: [
      { href: "/docs/", label: "Como usar o app" },
      { href: "/blog/", label: "Blog" },
      { href: "/comparar/", label: "Planilha, app ou Monnif?" },
      { href: "/para/casal/", label: "Para casais" },
      { href: "/para/saber-onde-o-dinheiro-vai/", label: "Para onde vai meu dinheiro" },
    ],
  },
  {
    titulo: "Legal",
    links: [
      { href: "/privacidade/", label: "Privacidade" },
      { href: "/termos/", label: "Termos de uso" },
      { href: "/excluir-conta/", label: "Excluir sua conta" },
      { href: "mailto:contato@monnif.com", label: "contato@monnif.com" },
    ],
  },
];
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/" style="font-size:1.05rem">
          <BrandMark size={30} />
          Monnif
        </a>
        <p>
          O dinheiro da casa organizado num lugar só, com um assistente que
          lança por você. Grátis, sem anúncio e sem venda de dados.
        </p>
      </div>

      {colunas.map((c) => (
        <div class="foot-col">
          <h4>{c.titulo}</h4>
          {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      ))}
    </div>

    <div class="foot-bottom">
      <span>© 2026 Monnif</span>
      <span>Feito no Brasil 🇧🇷</span>
      <!-- `rel="me"` é o par do sameAs do JSON-LD: um diz que o perfil é da
           marca, o outro que a marca é do perfil. -->
      <a href={INSTAGRAM} target="_blank" rel="me noopener">Instagram ↗</a>
      <a href={ENTRAR("rodape")} target="_blank" rel="noopener">Abrir o app ↗</a>
      <a href={EMPRESA_MAE.url} target="_blank" rel="noopener">Por Element Web ↗</a>
    </div>
  </div>
</footer>
