---
import BrandMark from "./BrandMark.astro";
import Tema from "./Tema.astro";
import { RECURSOS } from "../data/recursos";

const institucional = [
  { href: "/docs/", label: "Como usar" },
  { href: "/blog/", label: "Blog" },
  { href: "/manifesto/", label: "Nossa história" },
  { href: "/seguranca/", label: "Seus dados" },
];

const path = Astro.url.pathname;
---

<header id="header">
  <div class="wrap nav">
    <a class="logo" href="/" aria-label="Monnif — início">
      <BrandMark />
      Monnif
    </a>

    <nav class="nav-links" aria-label="Principal">
      <details class="mega">
        <summary>
          Recursos
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="mega-panel">
          <div class="mega-grid">
            {RECURSOS.map((r) => (
              <a class="mega-item" href={`/recursos/${r.slug}/`}>
                <span class="ico" aria-hidden="true">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill={r.iconeSolido ? "currentColor" : "none"} stroke={r.iconeSolido ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icone} />
                </span>
                <span>
                  <b>{r.titulo}</b>
                  <span>{r.resumo}</span>
                </span>
              </a>
            ))}
          </div>
          <div class="mega-foot">
            <span>Grátis para começar, sem anúncio e sem venda de dados.</span>
            <a href="/recursos/">Ver todos →</a>
          </div>
        </div>
      </details>

      {institucional.map((i) => (
        <a href={i.href} aria-current={path === i.href ? "page" : undefined}>{i.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <Tema />
      <a class="btn btn-primary btn-sm" href="https://app.monnif.com" target="_blank" rel="noopener">Entrar</a>
    </div>

    <details class="drawer">
      <summary class="burger" aria-label="Abrir menu">
        <svg class="open" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="close" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <div class="drawer-panel">
        <h4>Recursos</h4>
        {RECURSOS.map((r) => <a href={`/recursos/${r.slug}/`}>{r.titulo}</a>)}
        <a href="/recursos/">Ver todos</a>
        <h4>Monnif</h4>
        {institucional.map((i) => <a href={i.href}>{i.label}</a>)}
        <a class="btn btn-primary btn-lg" href="https://app.monnif.com/signup" target="_blank" rel="noopener">Criar conta grátis</a>
        <a class="btn btn-ghost btn-lg" href="https://app.monnif.com" target="_blank" rel="noopener">Entrar</a>
      </div>
    </details>
  </div>
</header>
