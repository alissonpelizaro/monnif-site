---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
const glifo = Math.round(size * 0.58);
---

<span
  class="logo-mark"
  aria-hidden="true"
  style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.3)}px`}
>
  <svg viewBox="0 0 40 40" width={glifo} height={glifo}>
    <path d="M8 30V13l11 11 11-11v17" fill="none" stroke="#fff" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</span>
