---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";

import ChatMock from "../components/ChatMock.astro";
import { RECURSOS, OUTROS } from "../data/recursos";

const titulo = "Monnif — O dinheiro da casa, organizado num lugar só";
const descricao =
  "App grátis para organizar o dinheiro da família: contas do mês, cartão de crédito, orçamento e o saldo dos próximos dias. Com um assistente que lança para você — é só escrever ou falar.";

const aplicativo = {
"@context": "https://schema.org",
"@type": "SoftwareApplication",
"name": "Monnif",
"applicationCategory": "FinanceApplication",
"operatingSystem": "Web, iOS, Android",
"description": "App grátis para organizar as finanças pessoais e da família: contas do mês, cartão de crédito, orçamento por categoria, saldo dos próximos dias, lembretes de vencimento e um assistente que lança por você.",
"featureList": [
  "Assistente que lança, paga e responde por escrito ou por voz",
  "Lembretes de vencimento e agenda de compromissos",
  "Contas compartilhadas com a família",
  "Cartão de crédito com fatura fechada na data certa e parcelas",
  "Orçamento por categoria",
  "Saldo previsto para os próximos dias",
  "Importação do extrato do banco"
],
"url": "https://app.monnif.com",
"offers": { "@type": "Offer", "price": "0", "priceCurrency": "BRL" },
"inLanguage": "pt-BR"
};
---

<Base title={titulo} description={descricao}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(aplicativo)} />


  <!-- ============================ HERO ============================ -->
  <div class="hero">
    <div class="wrap">
      <span class="pill reveal"><span class="dot" aria-hidden="true"></span> Grátis de verdade · sem plano pago</span>
      <h1 class="reveal" data-d="1">Saiba quanto sobra.<br /><span class="grad-text">Antes do mês acabar.</span></h1>
      <p class="sub reveal" data-d="2">
        As contas da casa, o cartão de crédito e o que a família gasta, num lugar só.
        E um assistente que anota por você: escreva “paguei o mercado, 240 no cartão”
        e pronto.
      </p>
      <div class="cta-row reveal" data-d="3">
        <a class="btn btn-primary btn-lg" href="https://app.monnif.com/signup" target="_blank" rel="noopener">
          Criar conta grátis
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="#assistente">Ver como funciona</a>
      </div>
      <p class="cta-note reveal" data-d="4">Leva menos de 1 minuto. Sem cartão de crédito, sem pegadinha.</p>

      <!-- Mockup do dashboard -->
      <div class="browser reveal" data-d="5">
        <div class="browser-bar" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="browser-url">app.monnif.com</span>
        </div>
        <div class="app">
          <div class="app-head">
            <div>
              <p class="app-kicker">Visão geral</p>
              <p class="app-title">Olá, Família Pelizaro</p>
              <p class="app-sub">Aqui está o resumo financeiro da sua conta.</p>
            </div>
            <div class="chips">
              <span class="chip on">Mensal</span>
              <span class="chip">Anual</span>
              <span class="chip">Fluxo</span>
            </div>
          </div>

          <div class="stat-grid">
            <div class="stat good">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--success) 14%,transparent);color:var(--success)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/><path d="M16 11h0"/></svg>
                </span>
                Sobra prevista
              </div>
              <p class="stat-value" style="color:var(--success)">R$ 3.418,71</p>
              <p class="stat-foot">R$ 16.819,00 receitas − R$ 13.400,29 despesas</p>
            </div>

            <div class="stat">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--warning) 14%,transparent);color:var(--warning)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v3l2 1"/></svg>
                </span>
                A pagar no mês
              </div>
              <div class="stat-row">
                <div>
                  <p class="stat-value">R$ 4.133,29</p>
                  <p class="stat-foot">R$ 9.267,00 já pagos de R$ 13.400,29</p>
                </div>
                <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true" style="flex:none">
                  <defs><linearGradient id="ring1" x1="0" y1="0" x2="52" y2="52"><stop offset="0" stop-color="var(--grad-a)"/><stop offset="1" stop-color="var(--grad-b)"/></linearGradient></defs>
                  <circle cx="26" cy="26" r="23" fill="none" stroke="oklch(1 0 0 / 10%)" stroke-width="5"/>
                  <circle cx="26" cy="26" r="23" fill="none" stroke="url(#ring1)" stroke-width="5" stroke-linecap="round"
                          stroke-dasharray="144.5" stroke-dashoffset="44.8" transform="rotate(-90 26 26)"/>
                  <text x="26" y="30" text-anchor="middle" font-size="11" font-weight="800" fill="currentColor" font-family="Inter, sans-serif">69%</text>
                </svg>
              </div>
            </div>

            <div class="stat">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--primary) 16%,transparent);color:var(--grad-a)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 7-7"/><path d="M14 7h6v6"/></svg>
                </span>
                Receitas do mês
              </div>
              <p class="stat-value">R$ 16.819,00</p>
              <p class="stat-foot">R$ 12.400,00 já recebidos</p>
            </div>
          </div>

          <div class="rows">
            <div class="row">
              <span class="tick" aria-hidden="true"></span>
              <span class="row-body">
                <span class="row-title">Escola do Vini</span>
                <span class="row-meta"><span class="late">Venceu 05/07</span> · <span class="cdot" style="background:#f472b6"></span> Educação</span>
              </span>
              <span class="row-amount" style="color:#fb923c">R$ 800,00</span>
            </div>
            <div class="row">
              <span class="tick" aria-hidden="true"></span>
              <span class="row-body">
                <span class="row-title">Fatura Nubank</span>
                <span class="row-meta">10/07 · <span class="cdot" style="background:var(--grad-a)"></span> Cartão</span>
              </span>
              <span class="row-amount" style="color:#ef4444">R$ 2.184,52</span>
            </div>
            <div class="row paid">
              <span class="tick done" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg></span>
              <span class="row-body">
                <span class="row-title">Aluguel</span>
                <span class="row-meta">05/07 · <span class="cdot" style="background:var(--success)"></span> Moradia</span>
              </span>
              <span class="row-amount" style="opacity:.55">R$ 2.900,00</span>
            </div>
          </div>
        </div>
      </div>

      <div class="metrics reveal">
        <div class="metric"><b class="grad-text">R$ 0</b><span>para sempre, sem plano pago</span></div>
        <div class="metric"><b class="grad-text">A família</b><span>toda vendo o mesmo número</span></div>
        <div class="metric"><b class="grad-text">Sem anúncio</b><span>e sem venda de dados</span></div>
        <div class="metric"><b class="grad-text">Sem instalar</b><span>abre no celular e no computador</span></div>
      </div>
    </div>
  </div>

  <!-- ============================ ASSISTENTE IA ============================ -->
  <section id="assistente">
    <div class="wrap">
      <div class="sec-head center reveal">
        <p class="kicker">O assistente</p>
        <h2>Não é um robô que dá conselho.<br /><span class="grad-text">É um que anota por você.</span></h2>
        <p class="lead">
          Ele está a um toque em qualquer tela. Diga o que aconteceu e ele resolve:
          lança a despesa, marca a conta como paga, quita a fatura do cartão, mostra
          quanto ainda dá para gastar este mês.
        </p>
      </div>

      <div class="split">
        <div class="reveal" data-d="1"><ChatMock /></div>

        <div class="split-txt reveal" data-d="2">
          <h2>Uma frase resolve.</h2>
          <p>
            Preencher formulário é o motivo pelo qual quase todo mundo desiste de
            anotar os gastos. Aqui você escreve o que aconteceu, do jeito que
            contaria para alguém, e o assistente faz o resto.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Anota o gasto</b>, inclusive parcelado e o que se repete todo mês</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Marca a conta como paga</b> e quita a fatura do cartão inteira</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Responde com número</b> — quanto sobra, quanto ainda cabe, quem gastou o quê</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Marca compromisso</b> e chama quem precisa estar junto</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Tudo o que ele faz</b> aparece na tela e você desfaz do jeito normal</span></li>
          </ul>
          <a class="btn btn-ghost" href="/recursos/assistente/" style="margin-top:22px">Conhecer o assistente</a>
        </div>
      </div>

      <div class="split" style="margin-top:clamp(64px,9vw,104px)">
        <div class="split-txt reveal">
          <p class="kicker">Ou fale</p>
          <h2>Sem digitar nada.</h2>
          <p>
            Segure o microfone e fale. O que você disse vira texto na tela — você lê,
            corrige se ele entendeu errado, e só então envia. Nada entra na sua conta
            sem passar pelos seus olhos.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Bom para o gasto do dia</b> — “gasolina, cento e oitenta reais”</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Você confere antes</b> — o que foi falado vira texto, não vira lançamento</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Escolha o tom</b> da resposta: formal, equilibrado ou descontraído</span></li>
          </ul>
        </div>

        <div class="panel reveal" data-d="2">
          <div class="chat" style="margin-bottom:14px">
            <div class="msg me">anota aí: gasolina, cento e oitenta reais, hoje</div>
            <div class="msg ai">Pronto — <b>Gasolina, R$ 180,00</b>, hoje, em Transporte. Quer que eu já marque como paga?</div>
          </div>

          <div class="chat-input" style="margin-top:0" aria-hidden="true">
            <span class="chat-btn ghost" style="background:color-mix(in oklch,var(--destructive) 18%,transparent);color:var(--destructive)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </span>
            <span class="wave"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span style="flex:1;font-size:.76rem;color:var(--muted);font-variant-numeric:tabular-nums">Gravando · 0:07</span>
            <span class="chat-btn send">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>
            </span>
          </div>

          <div style="display:flex;gap:7px;margin-top:14px;flex-wrap:wrap">
            <span class="chip" style="background:oklch(1 0 0 / 5%)">Formal</span>
            <span class="chip on">Equilibrado</span>
            <span class="chip" style="background:oklch(1 0 0 / 5%)">Descontraído 🙂</span>
          </div>
          <p style="font-size:.68rem;color:var(--faint);margin-top:9px">O tom fica salvo no seu perfil e vale em todas as contas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ RECURSOS ============================ -->
  <section id="recursos">
    <div class="wrap">
      <div class="sec-head center reveal">
        <p class="kicker">Recursos</p>
        <h2>Tudo que o dinheiro da casa precisa.<br />Nada do que ele não precisa.</h2>
        <p class="lead">Sem planilha que quebra e sem app de banco confuso. As contas do mês, o cartão, o que sobra e o que vem — num lugar só.</p>
      </div>

      <div class="features">
        {RECURSOS.map((r, i) => (
          <a class="feature reveal" data-d={i % 6} href={`/recursos/${r.slug}/`}>
            <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icone} /></span>
            <h3>{r.titulo}</h3>
            <p>{r.resumo}.</p>
          </a>
        ))}

        {OUTROS.map((o, i) => (
          <a class="feature reveal" data-d={i % 6} href={o.href}>
            <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg></span>
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CARTÃO ============================ -->
  <section id="cartao">
    <div class="wrap">
      <div class="split">
        <div class="split-txt reveal">
          <p class="kicker">Cartão de crédito</p>
          <h2>A fatura para de ser surpresa.</h2>
          <p>
            Você diz o dia em que o cartão fecha e o dia em que vence. Daí em diante
            cada compra cai na fatura certa sozinha, e a fatura aparece na lista como
            uma conta só — com tudo que tem dentro a um toque.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>A compra vai para o mês certo</b>, mesmo comprada depois do fechamento</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Parcela aparece mês a mês</b> — “3 de 10”, sem você fazer conta</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Quanto do limite já foi</b>, antes de a fatura chegar</span></li>
          </ul>
          <a class="btn btn-ghost" href="/recursos/cartao-de-credito/" style="margin-top:22px">Ver como funciona o cartão</a>
        </div>

        <div class="panel reveal" data-d="2">
          <div class="mock-list">
            <div class="mock-item">
              <div class="mock-item-head">
                <span class="mock-name"><span style="width:26px;height:17px;border-radius:4px;background:var(--grad);display:inline-block"></span> Nubank</span>
                <span class="mock-num">fecha dia 3 · vence dia 10</span>
              </div>
              <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px">
                <span style="font-size:1.3rem;font-weight:800;letter-spacing:-.04em;font-variant-numeric:tabular-nums">R$ 2.184,52</span>
                <span class="mock-num">fatura de julho</span>
              </div>
              <div class="bar-track"><div class="bar-fill" style="width:42%;background:var(--grad)"></div></div>
              <div class="mock-num" style="margin-top:7px">42% do limite de R$ 5.200,00</div>
            </div>

            <div class="mock-item" style="background:oklch(1 0 0 / 3%)">
              <div class="mock-num" style="margin-bottom:9px;font-weight:700;color:var(--muted)">Compras desta fatura</div>
              <div style="display:grid;gap:8px">
                <div style="display:flex;justify-content:space-between;font-size:.78rem"><span>Mercado São Jorge <span style="color:var(--faint)">· 02/07</span></span><span style="font-variant-numeric:tabular-nums">R$ 612,40</span></div>
                <div style="display:flex;justify-content:space-between;font-size:.78rem"><span>Notebook <span style="color:var(--faint)">· 3 de 10</span></span><span style="font-variant-numeric:tabular-nums">R$ 489,90</span></div>
                <div style="display:flex;justify-content:space-between;font-size:.78rem"><span>Posto Ipiranga <span style="color:var(--faint)">· 08/07</span></span><span style="font-variant-numeric:tabular-nums">R$ 310,00</span></div>
                <div style="display:flex;justify-content:space-between;font-size:.78rem;color:var(--faint)"><span>+ 14 outras</span><span style="font-variant-numeric:tabular-nums">R$ 772,22</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ AGENDA ============================ -->
  <section id="agenda">
    <div class="wrap">
      <div class="split rev">
        <div class="split-txt reveal">
          <p class="kicker">Agenda e lembretes</p>
          <h2>Dinheiro tem hora marcada.<br />O Monnif lembra por você.</h2>
          <p>
            Além das contas, a agenda: reunião com o contador, consulta, dia de
            renegociar o financiamento. Cada compromisso tem hora e o aviso chega
            com a antecedência que você escolher. Seus compromissos são seus — na
            conta da família, só quem você chamar enxerga.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Aviso três dias antes</b> de cada conta vencer</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Lembrete do compromisso</b> na hora que você pediu</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Quem você chamar</b> recebe o mesmo aviso, na mesma hora</span></li>
          </ul>
          <a class="btn btn-ghost" href="/recursos/agenda-e-lembretes/" style="margin-top:22px">Ver os lembretes</a>
        </div>

        <div class="panel reveal" data-d="2">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:13px">
            <span style="font-size:.95rem;font-weight:800;letter-spacing:-.03em">Quinta, 6 de agosto</span>
            <span class="mock-num">3 compromissos</span>
          </div>

          <div class="mock-list">
            <div class="mock-item appt">
              <span class="appt-time">09:00</span>
              <span class="appt-body">
                <span class="appt-title">Reunião com o contador</span>
                <span class="appt-meta">
                  <span class="badge high">Alta</span>
                  <span>lembrar 30 min antes</span>
                  <span class="faces" aria-hidden="true">
                    <span style="background:var(--grad-a)">A</span>
                    <span style="background:var(--grad-b)">M</span>
                  </span>
                </span>
              </span>
            </div>

            <div class="mock-item appt">
              <span class="appt-time">14:30</span>
              <span class="appt-body">
                <span class="appt-title">Renegociar o financiamento</span>
                <span class="appt-meta">
                  <span class="badge mid">Média</span>
                  <span>lembrar 1 h antes</span>
                </span>
              </span>
            </div>

            <div class="mock-item appt" style="opacity:.55">
              <span class="appt-time">07:30</span>
              <span class="appt-body">
                <span class="appt-title" style="text-decoration:line-through">Pagar a escola do Vini</span>
                <span class="appt-meta"><span class="badge low">Baixa</span><span>concluído</span></span>
              </span>
            </div>
          </div>

          <div class="toast">
            <span class="logo-mark" aria-hidden="true"></span>
            <span>
              <b>Reunião com o contador</b>
              <p>Começa em 30 minutos · Família Pelizaro</p>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ PREVISÃO ============================ -->
  <section id="previsao">
    <div class="wrap">
      <div class="split rev">
        <div class="split-txt reveal">
          <p class="kicker">O que vem pela frente</p>
