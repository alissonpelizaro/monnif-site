  <!-- ============================ ORÇAMENTO ============================ -->
  <section id="orcamento">
    <div class="wrap">
      <div class="split">
        <div class="split-txt reveal">
          <p class="kicker">Orçamento</p>
          <h2>Um limite para cada coisa.</h2>
          <p>
            Diga quanto pretende gastar por mês com mercado, transporte, lazer — e veja
            quanto já foi enquanto o mês ainda dá para mudar. Verde é tranquilo, amarelo
            é atenção, vermelho é que estourou. As categorias apertadas sobem para o
            topo da tela inicial sozinhas.
          </p>
          <a class="btn btn-ghost" href="/recursos/orcamento/" style="margin-top:22px">Ver o orçamento</a>
        </div>

        <div class="panel reveal" data-d="2">
          <div class="mock-list">
            <div class="mock-item">
              <div class="mock-item-head"><span class="mock-name">🛒 Alimentação</span><span class="mock-num">R$ 1.240 / R$ 1.800</span></div>
              <div class="bar-track"><div class="bar-fill" style="width:69%;background:var(--success)"></div></div>
            </div>
            <div class="mock-item">
              <div class="mock-item-head"><span class="mock-name">🚗 Transporte</span><span class="mock-num" style="color:var(--warning)">R$ 712 / R$ 800</span></div>
              <div class="bar-track"><div class="bar-fill" style="width:89%;background:var(--warning)"></div></div>
            </div>
            <div class="mock-item">
              <div class="mock-item-head"><span class="mock-name">🍿 Lazer</span><span class="mock-num" style="color:var(--destructive);font-weight:700">R$ 640 / R$ 500</span></div>
              <div class="bar-track"><div class="bar-fill" style="width:100%;background:var(--destructive)"></div></div>
            </div>
            <div class="mock-item">
              <div class="mock-item-head"><span class="mock-name">💊 Saúde</span><span class="mock-num">R$ 180 / R$ 900</span></div>
              <div class="bar-track"><div class="bar-fill" style="width:20%;background:var(--success)"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ FAQ ============================ -->
  <section id="faq">
    <div class="wrap">
      <div class="sec-head center reveal">
        <p class="kicker">Dúvidas</p>
        <h2>Perguntas honestas,<br />respostas honestas.</h2>
      </div>
      <div class="faq">
        {PERGUNTAS.map((f, i) => (
          <details class="reveal" data-d={i % 6} open={i === 0}>
            <summary>{f.pergunta}</summary>
            <p set:html={f.resposta} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta />

  <script is:inline>
  (function () {
    var h1 = document.querySelector(".frases");
    if (!h1 || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var frases = JSON.parse(h1.dataset.frases);
    var a = h1.querySelector(".frase-a");
    var b = h1.querySelector(".frase-b");
    var i = 0;

    setInterval(function () {
      i = (i + 1) % frases.length;
      h1.classList.add("trocando");
      setTimeout(function () {
        a.textContent = frases[i][0];
        b.textContent = frases[i][1];
        h1.classList.remove("trocando");
      }, 420);
    }, 5200);
  })();
  </script>
