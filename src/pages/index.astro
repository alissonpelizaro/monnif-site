---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";

const titulo = "Monnif — Suas finanças, com um assistente de IA junto";
const descricao =
  "Assistente financeiro com IA que lança, paga e projeta por você — por texto ou por voz. Mais cartão de crédito, orçamento por categoria, agenda de compromissos e importação de extrato. Grátis, em contas compartilhadas.";

const aplicativo = {
"@context": "https://schema.org",
"@type": "SoftwareApplication",
"name": "Monnif",
"applicationCategory": "FinanceApplication",
"operatingSystem": "Web, iOS, Android",
"description": "Gestão financeira pessoal e familiar com assistente de IA por texto e voz, contas compartilhadas, cartão de crédito, orçamento por categoria, projeção de saldo, agenda de compromissos e importação de extrato bancário.",
"featureList": [
  "Assistente financeiro com IA que executa ações por chat ou voz",
  "Ditado por voz com transcrição automática",
  "Agenda de compromissos com lembrete e convidados",
  "Notificações push e e-mail de vencimentos",
  "Contas compartilhadas com papéis",
  "Cartão de crédito com fatura por ciclo e parcelas",
  "Orçamento por categoria",
  "Projeção diária de saldo",
  "Importação de extrato OFX e CSV com conciliação"
],
"url": "https://app.monnif.com",
"offers": { "@type": "Offer", "price": "0", "priceCurrency": "BRL" },
"inLanguage": "pt-BR"
};
---

<Base title={titulo} description={descricao}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(aplicativo)} />


  <!-- ============================ HERO ============================ -->
  <div class="hero">
    <div class="wrap">
      <span class="pill reveal"><span class="dot" aria-hidden="true"></span> Novo · assistente com IA · 100% grátis</span>
      <h1 class="reveal" data-d="1">Fale com seu dinheiro.<br /><span class="grad-text">Ele responde — e resolve.</span></h1>
      <p class="sub reveal" data-d="2">
        Monnif reúne despesas, receitas, cartão de crédito e orçamento da sua família
        num só lugar, projeta o seu saldo dia a dia — e traz um assistente de IA que
        lança, paga e explica tudo isso por texto ou por voz.
      </p>
      <div class="cta-row reveal" data-d="3">
        <a class="btn btn-primary btn-lg" href="https://app.monnif.com/signup" target="_blank" rel="noopener">
          Criar conta grátis
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="#assistente">Ver o assistente</a>
      </div>
      <p class="cta-note reveal" data-d="4">Leva menos de 1 minuto. Sem plano pago, sem pegadinha.</p>

      <!-- Mockup do dashboard -->
      <div class="browser reveal" data-d="5">
        <div class="browser-bar" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="browser-url">app.monnif.com</span>
        </div>
        <div class="app">
          <div class="app-head">
            <div>
              <p class="app-kicker">Visão geral</p>
              <p class="app-title">Olá, Família Pelizaro</p>
              <p class="app-sub">Aqui está o resumo financeiro da sua conta.</p>
            </div>
            <div class="chips">
              <span class="chip on">Mensal</span>
              <span class="chip">Anual</span>
              <span class="chip">Fluxo</span>
            </div>
          </div>

          <div class="stat-grid">
            <div class="stat good">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--success) 14%,transparent);color:var(--success)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/><path d="M16 11h0"/></svg>
                </span>
                Sobra prevista
              </div>
              <p class="stat-value" style="color:var(--success)">R$ 3.418,71</p>
              <p class="stat-foot">R$ 16.819,00 receitas − R$ 13.400,29 despesas</p>
            </div>

            <div class="stat">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--warning) 14%,transparent);color:var(--warning)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v3l2 1"/></svg>
                </span>
                A pagar no mês
              </div>
              <div class="stat-row">
                <div>
                  <p class="stat-value">R$ 4.133,29</p>
                  <p class="stat-foot">R$ 9.267,00 já pagos de R$ 13.400,29</p>
                </div>
                <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true" style="flex:none">
                  <defs><linearGradient id="ring1" x1="0" y1="0" x2="52" y2="52"><stop offset="0" stop-color="var(--grad-a)"/><stop offset="1" stop-color="var(--grad-b)"/></linearGradient></defs>
                  <circle cx="26" cy="26" r="23" fill="none" stroke="oklch(1 0 0 / 10%)" stroke-width="5"/>
                  <circle cx="26" cy="26" r="23" fill="none" stroke="url(#ring1)" stroke-width="5" stroke-linecap="round"
                          stroke-dasharray="144.5" stroke-dashoffset="44.8" transform="rotate(-90 26 26)"/>
                  <text x="26" y="30" text-anchor="middle" font-size="11" font-weight="800" fill="currentColor" font-family="Inter, sans-serif">69%</text>
                </svg>
              </div>
            </div>

            <div class="stat">
              <div class="stat-label">
                <span class="stat-ico" style="background:color-mix(in oklch,var(--primary) 16%,transparent);color:var(--grad-a)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 7-7"/><path d="M14 7h6v6"/></svg>
                </span>
                Receitas do mês
              </div>
              <p class="stat-value">R$ 16.819,00</p>
              <p class="stat-foot">R$ 12.400,00 já recebidos</p>
            </div>
          </div>

          <div class="rows">
            <div class="row">
              <span class="tick" aria-hidden="true"></span>
              <span class="row-body">
                <span class="row-title">Escola do Vini</span>
                <span class="row-meta"><span class="late">Venceu 05/07</span> · <span class="cdot" style="background:#f472b6"></span> Educação</span>
              </span>
              <span class="row-amount" style="color:#fb923c">R$ 800,00</span>
            </div>
            <div class="row">
              <span class="tick" aria-hidden="true"></span>
              <span class="row-body">
                <span class="row-title">Fatura Nubank</span>
                <span class="row-meta">10/07 · <span class="cdot" style="background:var(--grad-a)"></span> Cartão</span>
              </span>
              <span class="row-amount" style="color:#ef4444">R$ 2.184,52</span>
            </div>
            <div class="row paid">
              <span class="tick done" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg></span>
              <span class="row-body">
                <span class="row-title">Aluguel</span>
                <span class="row-meta">05/07 · <span class="cdot" style="background:var(--success)"></span> Moradia</span>
              </span>
              <span class="row-amount" style="opacity:.55">R$ 2.900,00</span>
            </div>
          </div>
        </div>
      </div>

      <div class="metrics reveal">
        <div class="metric"><b class="grad-text">24</b><span>ações que a IA faz por você</span></div>
        <div class="metric"><b class="grad-text">Voz</b><span>ditado com transcrição</span></div>
        <div class="metric"><b class="grad-text">OFX/CSV</b><span>importação de extrato</span></div>
        <div class="metric"><b class="grad-text">R$ 0</b><span>para sempre</span></div>
      </div>
    </div>
  </div>

  <!-- ============================ ASSISTENTE IA ============================ -->
  <section id="assistente">
    <div class="wrap">
      <div class="sec-head center reveal">
        <p class="kicker">Assistente com IA</p>
        <h2>Não é um chatbot que dá conselho.<br /><span class="grad-text">É um que faz.</span></h2>
        <p class="lead">
          O botão flutuante abre o assistente em qualquer tela da conta. Peça em português
          e ele executa de verdade: cria a despesa, marca como paga, paga a fatura,
          define o orçamento, projeta o saldo e ainda te leva para a tela certa.
        </p>
      </div>

      <div class="split">
        <div class="panel reveal" data-d="1">
          <div class="chat">
            <div class="msg me">paguei o mercado agora, 240 reais no cartão do Nubank</div>

            <div class="msg-tool" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>
              criar_lancamento
            </div>

            <div class="msg ai">
              Lançado: <b>Mercado — R$ 240,00</b> no Nubank, categoria Alimentação.
              Entrou na fatura que fecha dia 3.
            </div>

            <div class="msg me">quanto ainda tenho pra gastar em alimentação esse mês?</div>

            <div class="msg-tool" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>
              listar_orcamentos
            </div>

            <div class="msg ai">
              Restam <b>R$ 320,00</b> dos R$ 1.800,00 do mês — 82% já usados, e ainda
              faltam 9 dias<span class="caret" aria-hidden="true"></span>
            </div>
          </div>

          <div class="chat-input" aria-hidden="true">
            <span>Escreva sua pergunta…</span>
            <span class="chat-btn ghost">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
            </span>
            <span class="chat-btn send">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </div>

        <div class="split-txt reveal" data-d="2">
          <h2>24 ações, uma frase.</h2>
          <p>
            O assistente usa exatamente as mesmas funções das telas — e as mesmas
            permissões que você tem na conta. Ele não enxerga nada além do que você
            já enxergaria, e a resposta aparece em streaming, palavra por palavra.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Lança e edita</b> despesas, receitas, parcelas e recorrências</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Marca como pago</b> e quita a fatura do cartão inteira</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Cria categoria, cartão e orçamento</b> sem você abrir formulário</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Responde com número</b> — resumo do mês, projeção de saldo, quem gastou o quê</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Navega por você</b> — "abre meus cartões" e a tela troca</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Convida gente</b> para a conta e agenda seus compromissos</span></li>
          </ul>
        </div>
      </div>

      <div class="split" style="margin-top:clamp(64px,9vw,104px)">
        <div class="split-txt reveal">
          <p class="kicker">Ditado por voz</p>
          <h2>Sem digitar nada.</h2>
          <p>
            Segure o microfone e fale. O Monnif grava, transcreve e coloca o texto no
            campo — você lê, corrige se quiser e só então envia. Nada sai da sua boca
            direto para a sua conta sem passar pelos seus olhos.
          </p>
          <ul class="checks">
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Até 30 segundos</b> por gravação, com as barras reagindo à sua voz</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Você revisa antes</b> — a transcrição vai para o campo, não para o envio</span></li>
            <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg><span><b>Escolha o tom</b> da resposta: formal, equilibrado ou descontraído</span></li>
          </ul>
        </div>

        <div class="panel reveal" data-d="2">
          <div class="chat" style="margin-bottom:14px">
            <div class="msg me">anota aí: gasolina, cento e oitenta reais, hoje</div>
            <div class="msg ai">Pronto — <b>Gasolina, R$ 180,00</b>, hoje, em Transporte. Quer que eu já marque como paga?</div>
          </div>

          <div class="chat-input" style="margin-top:0" aria-hidden="true">
            <span class="chat-btn ghost" style="background:color-mix(in oklch,var(--destructive) 18%,transparent);color:var(--destructive)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </span>
            <span class="wave"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span style="flex:1;font-size:.76rem;color:var(--muted);font-variant-numeric:tabular-nums">Gravando · 0:07</span>
            <span class="chat-btn send">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>
            </span>
          </div>

          <div style="display:flex;gap:7px;margin-top:14px;flex-wrap:wrap">
            <span class="chip" style="background:oklch(1 0 0 / 5%)">Formal</span>
            <span class="chip on">Equilibrado</span>
            <span class="chip" style="background:oklch(1 0 0 / 5%)">Descontraído 🙂</span>
          </div>
          <p style="font-size:.68rem;color:var(--faint);margin-top:9px">O tom fica salvo no seu perfil e vale em todas as contas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ RECURSOS ============================ -->
  <section id="recursos">
    <div class="wrap">
      <div class="sec-head center reveal">
        <p class="kicker">Recursos</p>
        <h2>Tudo que o seu dinheiro precisa.<br />Nada do que ele não precisa.</h2>
        <p class="lead">Sem planilha quebrada, sem app de banco confuso. O essencial de uma vida financeira inteira — feito com cuidado.</p>
      </div>

      <div class="features">
        <div class="feature reveal">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/></svg></span>
          <h3>Assistente com IA</h3>
          <p>Peça em português e ele executa: lançar, pagar, orçar, projetar, convidar. 24 ações, as mesmas das telas e com as suas permissões.</p>
          <span class="tag">Novo</span>
        </div>

        <div class="feature reveal" data-d="1">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span>
          <h3>Lança por voz</h3>
          <p>Fale "mercado, 240 reais" e pronto. Grava até 30s, transcreve e deixa o texto no campo para você conferir antes de enviar.</p>
          <span class="tag">Novo</span>
        </div>

        <div class="feature reveal" data-d="2">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v3l2 1"/></svg></span>
          <h3>Agenda de compromissos</h3>
          <p>Reunião, consulta, vencimento importante. Marque a hora, a importância e quem participa — e receba o lembrete antes.</p>
          <span class="tag">Novo</span>
        </div>

        <div class="feature reveal" data-d="3">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
          <h3>Lembretes e resumo</h3>
          <p>Notificação no celular 3 dias antes do vencimento, aviso do compromisso na hora certa e o resumo do mês no e-mail.</p>
          <span class="tag">Novo</span>
        </div>

        <div class="feature reveal" data-d="4">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <h3>Contas compartilhadas</h3>
          <p>Casa, família ou empresa. Convide pessoas com papéis de Dono, Admin e Membro — todo mundo vendo o mesmo número.</p>
        </div>

        <div class="feature reveal" data-d="5">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
          <h3>Cartão de crédito</h3>
          <p>Compras entram na fatura do ciclo certo e o vencimento vira o da fatura. A fatura vira uma linha só na lista de despesas.</p>
        </div>

        <div class="feature reveal">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/></svg></span>
          <h3>Orçamento por categoria</h3>
          <p>Um teto mensal por categoria e o quanto já foi gasto. As que chegam perto do limite sobem para o topo do dashboard.</p>
        </div>

        <div class="feature reveal" data-d="1">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg></span>
          <h3>Projeção de saldo</h3>
          <p>Saldo real em caixa hoje e a curva dos próximos dias. Descubra em que data a conta fica no vermelho — com antecedência.</p>
        </div>

        <div class="feature reveal" data-d="2">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg></span>
          <h3>Importação de extrato</h3>
          <p>Envie o OFX ou CSV do banco. O Monnif concilia com o que já estava previsto, aponta duplicadas e deixa você desfazer tudo.</p>
        </div>

        <div class="feature reveal" data-d="3">
          <span class="ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/></svg></span>
          <h3>Categorização automática</h3>
          <p>Regras aprendidas com o seu uso. Categorize a mesma descrição algumas vezes e o Monnif passa a preencher sozinho.</p>
        </div>

        <div class="feature reveal" data-d="4">
