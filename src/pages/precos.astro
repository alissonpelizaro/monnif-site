---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import Plano from "../components/Plano.astro";
import { CRIAR_CONTA } from "../data/app";
import { SITE, grafo, migalha } from "../data/seo";

const url = `${SITE}/precos/`;

/*
 * Os preços moram no painel (`_config`, chave `billing.prices`) e mudam sem
 * deploy. Aqui eles são cópia, e é a única forma honesta de mostrar preço numa
 * página estática — o app é quem cobra, e é lá que o número vale.
 *
 * **Mexeu no painel, mexa aqui.** São dois números por plano pago: `mensal` é
 * o que sai do bolso todo mês, `anual` é quanto fica cada mês de quem paga o
 * ano de uma vez. Tudo o mais — o "R$", a economia em %, o total do ano lá na
 * dúvida — é **derivado** deles. Não existe percentual escrito à mão para
 * envelhecer sozinho quando o preço mudar.
 *
 * **Estes são os preços de quem assina no site.** Quem assina dentro do app do
 * iPhone ou do Android paga o valor da loja, que sai de uma tabela de faixas
 * da Apple e do Google e não bate com o nosso ao centavo. Por isso a página
 * diz de quais preços está falando, em vez de deixar a pessoa descobrir a
 * diferença na hora de pagar — e por isso não existe aqui nenhuma promessa de
 * que o valor é o mesmo em todo canto.
 */
const PLANOS = [
  {
    id: "free",
    nome: "Grátis",
    chamada: "Para começar a enxergar o mês",
    icone: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
    mensal: 0,
    anual: 0,
    detalhe: "Para sempre, sem cartão no cadastro",
    destaque: false,
    listaTitulo: "O que já vem",
    botao: "Criar conta grátis",
    inclui: [
      "Assistente no WhatsApp: lance por mensagem ou áudio",
      "2 contas, com até 2 pessoas em cada",
      "2 carteiras e 2 cartões de crédito",
      "Contas fixas e compras parceladas",
      "Relatórios e exportação",
      "Lembrete de conta vencendo",
    ],
  },
  {
    id: "plus",
    nome: "Plus",
    chamada: "Para quem já anota todo dia",
    icone: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
    mensal: 19.9,
    anual: 15.9,
    detalhe: "",
    destaque: true,
    listaTitulo: "Tudo do Grátis, mais",
    botao: "Começar no Plus",
    inclui: [
      "Limites bem mais altos em tudo",
      "4 carteiras, 5 cartões, 4 pessoas na conta",
      "Leitura de cupom por foto",
      "Categoria automática: o app aprende e classifica",
      "6 meses de histórico nos relatórios",
      "10 importações de extrato por mês",
    ],
  },
  {
    id: "super",
    nome: "Super",
    chamada: "Para quem cuida de mais de um bolso",
    icone: `<path d="M2 18h20"/><path d="M4 14l-2-8 6 4 4-7 4 7 6-4-2 8z"/>`,
    mensal: 26.9,
    anual: 19.9,
    detalhe: "",
    destaque: false,
    listaTitulo: "Tudo do Plus, mais",
    botao: "Começar no Super",
    inclui: [
      "Contas, carteiras, cartões e pessoas sem limite",
      "Histórico sem limite de tempo",
      "Divisão de despesa entre as pessoas da conta",
      "Categorias, metas e compromissos sem limite",
      "500 mensagens e 300 ditados por mês",
      "100 anexos e 30 importações por mês",
    ],
  },
];

const real = new Intl.NumberFormat("pt-BR", {
  style: "currency",
  currency: "BRL",
});

const cards = PLANOS.map((p) => {
  const pago = p.mensal > 0;
  return {
    id: p.id,
    nome: p.nome,
    chamada: p.chamada,
    icone: p.icone,
    anual: pago ? real.format(p.anual) : "R$ 0",
    mensal: pago ? real.format(p.mensal) : "R$ 0",
    // "/mês" só nos pagos: "R$ 0/mês" soa a pegadinha esperando a letra miúda.
    sufixo: pago ? "/mês" : "",
    detalheAnual: pago ? "Cobrado uma vez por ano" : p.detalhe,
    detalheMensal: pago ? "Cobrado todo mês" : p.detalhe,
    desconto: pago ? Math.round((1 - p.anual / p.mensal) * 100) : null,
    destaque: p.destaque,
    listaTitulo: p.listaTitulo,
    inclui: p.inclui,
    botao: p.botao,
  };
});

// A aba anual anuncia o maior desconto da tabela, não uma média: é o teto do
// que dá para ganhar, e cada card mostra o número exato do plano dele.
const maiorDesconto = Math.max(...cards.map((c) => c.desconto ?? 0));

// O total do ano saiu do card — era um número grande no meio da comparação e
// ninguém compara anuidade com mensalidade — mas continua sendo o valor que a
// fatura mostra. Então ele vive na dúvida sobre pagamento, montado dos mesmos
// dois campos, em vez de escrito à mão num terceiro lugar.
const totalAno = PLANOS.filter((p) => p.mensal > 0)
  .map((p) => `${p.nome}, ${real.format(p.anual * 12)}`)
  .join("; ");

const duvidas = [
  {
    pergunta: "Preciso de cartão de crédito para criar a conta?",
    resposta:
      "Não. O plano grátis não pede cartão e não expira: não é teste de 7 dias nem período promocional. Você só informa uma forma de pagamento se decidir assinar.",
  },
  {
    pergunta: "Qual a diferença entre o mensal e o anual?",
    resposta: `O mensal cobra todo mês e você sai quando quiser. O anual cobra o ano inteiro de uma vez e sai mais barato por mês — até ${maiorDesconto}% de diferença. Em número cheio, o que aparece na fatura do anual é: ${totalAno}.`,
  },
  {
    pergunta: "Como eu pago, e o preço é o mesmo em todo lugar?",
    resposta:
      "No site é PIX, boleto ou cartão de crédito, pelos valores desta página — no PIX e no cartão o plano entra no ar na hora. Assinando dentro do app do iPhone ou do Android, quem cobra é a loja, e o valor é o que aparece lá: a Apple e o Google trabalham com faixas de preço próprias, então pode dar uma diferença de alguns centavos ou reais. Em qualquer um dos caminhos o plano é o mesmo e vale na mesma conta.",
  },
  {
    pergunta: "O que acontece se eu parar de pagar?",
    resposta:
      "A conta volta para o plano grátis e nada é apagado: os lançamentos, as carteiras e o histórico continuam lá, e voltam a aparecer inteiros se você assinar de novo. O que muda são os limites de quanta coisa nova dá para criar.",
  },
  {
    pergunta: "Dá para assinar e cancelar quando eu quiser?",
    resposta:
      "Dá. A renovação automática é opcional e fica desligada por padrão quando você paga no PIX ou no boleto — nesses casos só sai do seu bolso o que você mandou sair. Assinatura feita pela loja do celular é cancelada na própria loja.",
  },
  {
    pergunta: "O grátis é isca para virar pago depois?",
    resposta:
      "Não. Conta compartilhada, assistente no WhatsApp e relatórios — que costumam ser justamente o que fica atrás da assinatura em outros lugares — estão no plano grátis, e continuam.",
  },
];

const dados = grafo(
  {
    "@type": "FAQPage",
    "@id": `${url}#duvidas`,
    mainEntity: duvidas.map((d) => ({
      "@type": "Question",
      name: d.pergunta,
      acceptedAnswer: { "@type": "Answer", text: d.resposta },
    })),
  },
  migalha([{ nome: "Preços" }]),
);
---

<Base
  title="Preços e planos — Monnif"
  description="O Monnif é grátis para usar, sem cartão no cadastro e sem prazo para acabar. Veja o que vem no plano grátis e quanto custam o Plus e o Super."
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(dados)} />

  <div class="page-head">
    <div class="wrap">
      <p class="kicker">Preços</p>
      <h1>Começa de graça.<br /><span class="grad-text">E continua dando.</span></h1>
      <p class="lead">
        Sem cartão no cadastro, sem teste que expira e sem anúncio. Os planos
        pagos existem para quem precisa de mais espaço — não para desbloquear o
        que você já usa.
      </p>
    </div>
  </div>

  <section style="padding-top:0">
    <div class="wrap">
      {/*
        O ciclo é dois rádios e CSS, sem JavaScript: a troca precisa valer já na
        primeira pintura, e o navegador faz isso sozinho. Os rádios têm que ser
        irmãos de `.planos` — é o `~` que apaga o preço do ciclo não marcado.
      */}
      <div class="ciclo">
        <input class="ciclo-radio" type="radio" name="ciclo" id="ciclo-mensal" />
        <input class="ciclo-radio" type="radio" name="ciclo" id="ciclo-anual" checked />

        <div class="chips ciclo-chips">
          <label class="chip" for="ciclo-mensal">Mensal</label>
          <label class="chip" for="ciclo-anual">
            Anual <span class="ciclo-off">−{maiorDesconto}%</span>
          </label>
        </div>

        <div class="planos">
          {cards.map((p, i) => (
            <Plano plano={p} href={CRIAR_CONTA(`precos-${p.id}`)} ordem={i + 1} />
          ))}
        </div>
      </div>

      <p class="planos-nota">
        Todo plano pago começa pelo grátis: você cria a conta, usa, e assina
        depois, quando fizer sentido. <strong>Os valores acima são os de quem
        assina pelo site</strong> — assinando dentro do app do iPhone ou do
        Android, vale o preço da loja, que pode ser um pouco diferente.
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="prose reveal">
        <h2>Dúvidas de quem está decidindo</h2>
        {duvidas.map((d) => (
          <>
            <h3>{d.pergunta}</h3>
            <p>{d.resposta}</p>
          </>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* Fora da tela, mas ainda focável e ainda anunciado: esconder com `display`
     tiraria os rádios do teclado e do leitor de tela, e o seletor viraria uma
     coisa que só o mouse alcança. */
  .ciclo-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .ciclo-chips {
    width: fit-content;
    margin: 0 auto 26px;
  }

  .ciclo-chips .chip {
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    user-select: none;
    transition: color 0.2s var(--ease-soft), background 0.2s var(--ease-soft);
  }

  .ciclo-off {
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 800;
    color: var(--success);
    background: color-mix(in oklch, var(--success) 16%, transparent);
  }

  #ciclo-mensal:checked ~ .ciclo-chips .chip[for="ciclo-mensal"],
  #ciclo-anual:checked ~ .ciclo-chips .chip[for="ciclo-anual"] {
    background: oklch(var(--tint) / 9%);
    color: var(--foreground);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  #ciclo-mensal:focus-visible ~ .ciclo-chips .chip[for="ciclo-mensal"],
  #ciclo-anual:focus-visible ~ .ciclo-chips .chip[for="ciclo-anual"] {
    outline: 2px solid var(--acento);
    outline-offset: 2px;
  }

  /* O card desenha os dois preços; aqui some o do ciclo que não está marcado.
     `:global` porque as classes nascem dentro do Plano.astro, e o escopo do
     Astro não alcança o filho a partir daqui. */
  #ciclo-anual:checked ~ .planos :global(.so-mensal),
  #ciclo-mensal:checked ~ .planos :global(.so-anual) {
    display: none;
  }

  .planos {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    /* Sem `align-items: start`: os três cards esticam até a altura da linha, e
       é isso que faz os botões terminarem na mesma reta mesmo com listas de
       tamanhos diferentes. Com `start`, cada card para onde o texto acaba e os
       botões ficam em três alturas. */
  }

  .planos-nota {
    margin: 22px auto 0;
    max-width: 62ch;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
