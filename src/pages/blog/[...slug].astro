---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { AUTORA } from "../../data/autoria";
import { EDITORA, ID_SITE, SITE, grafo, migalha } from "../../data/seo";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Os vizinhos na ordem cronológica viram "leia também" no fim do texto.
    props: { post, relacionados: [posts[i - 1], posts[i + 1]].filter(Boolean) },
  }));
}

const { post, relacionados } = Astro.props;
const { Content } = await render(post);

// A data vem de um `YYYY-MM-DD`, que o zod lê como meia-noite UTC. Sem fixar o
// fuso, quem estiver no Brasil vê o dia anterior.
const dia = post.data.date.toLocaleDateString("pt-BR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const palavras = post.body.split(/\s+/).length;
const minutos = Math.max(2, Math.round(palavras / 200));

const url = `${SITE}/blog/${post.id}/`;
const capa = `${SITE}/og/blog-${post.id}.png`;
const publicado = post.data.date.toISOString();

const dados = grafo(
  {
    "@type": "BlogPosting",
    "@id": `${url}#artigo`,
    headline: post.data.title,
    description: post.data.description,
    image: capa,
    datePublished: publicado,
    // Sem data de revisão no frontmatter, a de publicação é a informação honesta.
    dateModified: publicado,
    inLanguage: "pt-BR",
    articleSection: post.data.tag,
    wordCount: palavras,
    timeRequired: `PT${minutos}M`,
    author: { "@type": "Person", name: AUTORA.nome, url: AUTORA.perfil },
    publisher: EDITORA,
    isPartOf: { "@id": `${SITE}/blog/#blog` },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${url}#pagina` },
  },
  {
    "@type": "Blog",
    "@id": `${SITE}/blog/#blog`,
    name: "Blog da Monnif",
    url: `${SITE}/blog/`,
    inLanguage: "pt-BR",
    publisher: EDITORA,
    isPartOf: { "@id": ID_SITE },
  },
  migalha([{ nome: "Blog", url: "/blog/" }, { nome: post.data.title }]),
);
---

<Base
  title={`${post.data.title} — Monnif`}
  description={post.data.description}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(dados)} />
    <meta property="article:published_time" content={publicado} />
    <meta property="article:modified_time" content={publicado} />
    <meta property="article:section" content={post.data.tag} />
    <meta property="article:author" content={AUTORA.nome} />
    <meta name="author" content={AUTORA.nome} />
  </Fragment>

  <div class="wrap">
    <div class="page-head post-head">
      <p class="doc-crumb"><a href="/blog/">Blog</a> · {post.data.tag}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="updated">
        Por <a href={AUTORA.perfil} rel="author noopener" target="_blank">{AUTORA.nome}</a>{" · "}<time datetime={post.data.date.toISOString()}>{dia}</time> · {minutos} min de leitura
      </p>
    </div>

    <article class="prose">
      <Content />

      {relacionados.length > 0 && (
        <div class="post-mais">
          <h4>Leia também</h4>
          {relacionados.map((p) => (
            <a href={`/blog/${p.id}/`}>
              <span>{p.data.tag}</span>
              <b>{p.data.title}</b>
            </a>
          ))}
        </div>
      )}
    </article>
  </div>

  <Cta />
</Base>
