---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { EDITORA, ID_SITE, SITE, grafo, lista, migalha } from "../../data/seo";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dados = grafo(
  {
    "@type": "Blog",
    "@id": `${SITE}/blog/#blog`,
    name: "Blog da Monnif",
    description:
      "Textos sobre orçamento, cartão de crédito, reserva de emergência e dinheiro a dois — e guias de como cada parte do Monnif funciona.",
    url: `${SITE}/blog/`,
    inLanguage: "pt-BR",
    publisher: EDITORA,
    isPartOf: { "@id": ID_SITE },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      "@id": `${SITE}/blog/${p.id}/#artigo`,
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.date.toISOString(),
      url: `${SITE}/blog/${p.id}/`,
    })),
  },
  lista(
    "Posts do blog da Monnif",
    posts.map((p) => ({ nome: p.data.title, url: `/blog/${p.id}/` })),
  ),
  migalha([{ nome: "Blog" }]),
);

// O post em destaque abre a página; o resto vai para a grade, na ordem da data.
const destaque = posts.find((p) => p.data.destaque) ?? posts[0];
const resto = posts.filter((p) => p !== destaque);

const dia = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Base
  title="Blog: orçamento, cartão e dinheiro da casa — Monnif"
  description="Textos sobre orçamento, cartão de crédito, reserva de emergência e dinheiro a dois — e guias de como cada parte do Monnif funciona."
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(dados)} />

  <div class="wrap">
    <div class="page-head">
      <p class="kicker">Blog</p>
      <h1>Dinheiro explicado <span class="grad-text">sem enrolação</span></h1>
      <p class="lead">
        O que a gente aprendeu construindo um app de finanças: o que funciona no
        orçamento de uma casa, o que quebra, e como usar cada parte do Monnif.
      </p>
    </div>

    <a class="post-destaque" href={`/blog/${destaque.id}/`}>
      <span class="post-tag">{destaque.data.tag}</span>
      <h2>{destaque.data.title}</h2>
      <p>{destaque.data.description}</p>
      <span class="post-data">
        <time datetime={destaque.data.date.toISOString()}>{dia(destaque.data.date)}</time>
        <span>Ler →</span>
      </span>
    </a>

    <div class="post-grid">
      {resto.map((p) => (
        <a class="post-card" href={`/blog/${p.id}/`}>
          <span class="post-tag">{p.data.tag}</span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="post-data">
            <time datetime={p.data.date.toISOString()}>{dia(p.data.date)}</time>
          </span>
        </a>
      ))}
    </div>
  </div>

  <Cta
    titulo="Ler é bom."
    destaque="Fazer é melhor."
    texto="Crie sua conta, importe o extrato do último mês e veja o retrato de verdade."
  />
</Base>
