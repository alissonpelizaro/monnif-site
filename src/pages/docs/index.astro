---
import Base from "../../layouts/Base.astro";
import DocNav from "../../components/DocNav.astro";
import { getCollection } from "astro:content";
import { SECOES } from "../../content/docs/secoes";

const paginas = await getCollection("docs");
const porSecao = SECOES.map((s) => ({
  ...s,
  itens: paginas
    .filter((p) => p.id.startsWith(`${s.slug}/`))
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<Base
  title="Documentação — Monnif"
  description="Como usar cada tela do Monnif: dashboard, despesas, cartões, orçamento, metas, relatórios, importação de extrato, contas compartilhadas e o assistente de IA."
>
  <div class="doc-wrap">
    <DocNav />

    <article>
      <div class="doc-head">
        <p class="kicker">Documentação</p>
        <h1>Como usar o Monnif</h1>
        <p class="lead">
          Uma página por tela do app, com o passo a passo, o print e o que pedir
          ao assistente para fazer a mesma coisa sem abrir formulário.
        </p>
      </div>

      <div class="doc-index">
        {porSecao.map((s) => (
          <div class="doc-card">
            <h3>{s.titulo}</h3>
            {s.itens.map((p) => <a href={`/docs/${p.id}/`}>{p.data.title}</a>)}
          </div>
        ))}
      </div>

      <div class="doc-peca" style="margin-top:32px">
        <span class="ico" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/></svg>
        </span>
        <span>
          <b>Não achou o que procurava?</b>
          <q>Escreva para contato@monnif.com — a documentação cresce com as perguntas que chegam.</q>
        </span>
      </div>
    </article>
  </div>
</Base>
