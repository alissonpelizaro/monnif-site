---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import ChatMock from "../../components/ChatMock.astro";
import { RECURSOS } from "../../data/recursos";

export function getStaticPaths() {
  return RECURSOS.map((r) => ({ params: { slug: r.slug }, props: { recurso: r } }));
}

const { recurso } = Astro.props;
const outros = RECURSOS.filter((r) => r.slug !== recurso.slug);

// Os prints são os mesmos da documentação, importados de src/assets para o
// Astro otimizar e versionar.
const prints = import.meta.glob<{ default: ImageMetadata }>("/src/assets/docs/*.webp", {
  eager: true,
});
const imagem = recurso.print ? prints[`/src/assets/docs/${recurso.print}.webp`]?.default : undefined;

const migalha = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Recursos", item: "https://monnif.com/recursos/" },
    { "@type": "ListItem", position: 2, name: recurso.titulo },
  ],
};
---

<Base
  title={`${recurso.titulo} — Monnif`}
  description={recurso.resumo + ". " + recurso.lead}
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(migalha)} />
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: recurso.duvidas.map((d) => ({
      "@type": "Question",
      name: d.pergunta,
      acceptedAnswer: { "@type": "Answer", text: d.resposta },
    })),
  })} />

  <div class="wrap">
    <div class="page-head">
      <p class="doc-crumb"><a href="/recursos/">Recursos</a> · {recurso.titulo}</p>
      <h1>{recurso.chamada}</h1>
      <p class="lead">{recurso.lead}</p>
      <div class="cta-row" style="justify-content:center;margin-top:26px">
        <a class="btn btn-primary btn-lg" href="https://app.monnif.com/signup" target="_blank" rel="noopener">
          Criar conta grátis
        </a>
        <a class="btn btn-ghost btn-lg" href={recurso.docs.href}>{recurso.docs.label}</a>
      </div>
    </div>

    <div class="recurso-mock reveal">
      {imagem
        ? <div class="doc-print"><Image src={imagem} alt={`Tela de ${recurso.titulo} no Monnif`} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 860px" loading="eager" /></div>
        : <ChatMock />}
    </div>

    <div class="principles" style="margin-top:clamp(48px,7vw,80px)">
      {recurso.pontos.map((p) => (
        <div class="principle reveal">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>

    <section id="duvidas">
      <div class="sec-head center reveal">
        <h2>Perguntas comuns</h2>
      </div>
      <div class="faq">
        {recurso.duvidas.map((d, i) => (
          <details class="reveal" open={i === 0}>
            <summary>{d.pergunta}</summary>
            <p>{d.resposta}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="recurso-outros">
      <h4>Outros recursos</h4>
      <div class="recurso-grid">
        {outros.map((r) => (
          <a class="recurso-card" href={`/recursos/${r.slug}/`}>
            <span class="ico" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icone} />
            </span>
            <b>{r.titulo}</b>
            <span>{r.resumo}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <Cta />
</Base>
