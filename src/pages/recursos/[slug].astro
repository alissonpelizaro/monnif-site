---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import ChatMock from "../../components/ChatMock.astro";
import WhatsAppPrint from "../../components/WhatsAppPrint.astro";
import { RECURSOS } from "../../data/recursos";
import { EDITORA, ID_SITE, SITE, grafo, migalha, resumir } from "../../data/seo";

export function getStaticPaths() {
  return RECURSOS.map((r) => ({ params: { slug: r.slug }, props: { recurso: r } }));
}

const { recurso } = Astro.props;
const outros = RECURSOS.filter((r) => r.slug !== recurso.slug);

// Os prints são os mesmos da documentação, importados de src/assets para o
// Astro otimizar e versionar.
const prints = import.meta.glob<{ default: ImageMetadata }>("/src/assets/docs/*.webp", {
  eager: true,
});
const imagem = recurso.print ? prints[`/src/assets/docs/${recurso.print}.webp`]?.default : undefined;

const url = `${SITE}/recursos/${recurso.slug}/`;

const dados = grafo(
  {
    // Mesmo `@id` da home: é o mesmo app, visto pelo lado de um recurso só.
    "@type": "SoftwareApplication",
    "@id": `${SITE}/#app`,
    name: "Monnif",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web, iOS, Android",
    description: recurso.lead,
    featureList: recurso.pontos.map((p) => `${p.titulo}: ${p.texto}`),
    url: "https://app.monnif.com",
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
    publisher: EDITORA,
    inLanguage: "pt-BR",
    isPartOf: { "@id": ID_SITE },
    ...(imagem ? { screenshot: new URL(imagem.src, SITE).href } : {}),
  },
  // Só os recursos que têm configuração ganham HowTo — é o que o buscador
  // mostra numerado no resultado, e ele exige que os passos estejam à vista
  // na página, que é o bloco `.passos` lá embaixo.
  ...(recurso.passos
    ? [
        {
          "@type": "HowTo",
          "@id": `${url}#passo-a-passo`,
          name: recurso.passos.titulo,
          description: recurso.lead,
          totalTime: "PT2M",
          step: recurso.passos.itens.map((p, i) => ({
            "@type": "HowToStep",
            position: i + 1,
            name: p.nome,
            text: p.texto,
            url: `${url}#passo-a-passo`,
          })),
        },
      ]
    : []),
  {
    "@type": "FAQPage",
    "@id": `${url}#duvidas`,
    mainEntity: recurso.duvidas.map((d) => ({
      "@type": "Question",
      name: d.pergunta,
      acceptedAnswer: { "@type": "Answer", text: d.resposta },
    })),
  },
  migalha([{ nome: "Recursos", url: "/recursos/" }, { nome: recurso.titulo }]),
);
---

<Base
  title={recurso.tituloSeo}
  description={resumir(`${recurso.resumo}. ${recurso.lead}`)}
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(dados)} />

  <div class="wrap">
    <div class="page-head">
      <p class="doc-crumb"><a href="/recursos/">Recursos</a> · {recurso.titulo}</p>
      <h1>{recurso.chamada}</h1>
      <p class="lead">{recurso.lead}</p>
      <div class="cta-row" style="justify-content:center;margin-top:26px">
        <a class="btn btn-primary btn-lg" href="https://app.monnif.com/signup" target="_blank" rel="noopener">
          Criar conta grátis
        </a>
        <a class="btn btn-ghost btn-lg" href={recurso.docs.href}>{recurso.docs.label}</a>
      </div>
    </div>

    {/* Sem print do app, entra uma conversa — a captura real do WhatsApp na
        página do WhatsApp, o exemplo do assistente no resto. */}
    <div class="recurso-mock reveal">
      {imagem
        ? <div class="doc-print"><Image src={imagem} alt={`Tela de ${recurso.titulo} no Monnif`} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 860px" loading="eager" /></div>
        : recurso.slug === "whatsapp"
          ? <WhatsAppPrint eager />
          : <ChatMock />}
    </div>

    <div class="principles" style="margin-top:clamp(48px,7vw,80px)">
      {recurso.pontos.map((p) => (
        <div class="principle reveal">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>

    {recurso.passos && (
      <section id="passo-a-passo">
        <div class="sec-head center reveal">
          <h2>{recurso.passos.titulo}</h2>
        </div>
        <div class="principles">
          {recurso.passos.itens.map((p, i) => (
            <div class="principle reveal">
              <span class="num">{i + 1}</span>
              <h3>{p.nome}</h3>
              <p>{p.texto}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section id="duvidas">
      <div class="sec-head center reveal">
        <h2>Perguntas comuns</h2>
      </div>
      <div class="faq">
        {recurso.duvidas.map((d, i) => (
          <details class="reveal" open={i === 0}>
            <summary>{d.pergunta}</summary>
            <p>{d.resposta}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="recurso-outros">
      <h4>Outros recursos</h4>
      <div class="recurso-grid">
        {outros.map((r) => (
          <a class="recurso-card" href={`/recursos/${r.slug}/`}>
            <span class="ico" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icone} />
            </span>
            <b>{r.titulo}</b>
            <span>{r.resumo}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <Cta />
</Base>
