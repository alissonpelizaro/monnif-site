---
import { existsSync } from "node:fs";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Visita from "../components/Visita.astro";
import { CRIADOR, EMPRESA_MAE, ID_ORG, ID_SITE, PERFIS, SITE } from "../data/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** "article" nos posts do blog; o resto do site é "website". */
  ogType?: "website" | "article";
}

const { title, description, ogImage, noindex = false, ogType = "website" } = Astro.props;

// A imagem de compartilhamento de cada página é gerada por scripts/og.mjs
// antes do build, com esta mesma regra de nome. Se faltar alguma, cai na da
// home em vez de apontar para um arquivo que não existe.
const nomeOg = Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
const gerada = `/og/${nomeOg}.png`;
const temGerada = existsSync(`${process.cwd()}/public${gerada}`);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage ?? (temGerada ? gerada : "/og/home.png"), Astro.site).href;

// Organization, WebSite e a página atual num grafo só, com `@id` estável: as
// outras páginas apontam para esses ids em vez de repetir o objeto inteiro.
// O logo é PNG de propósito — o Google não aceita SVG no logo da Organization.
const grafoBase = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ID_ORG,
      name: "Monnif",
      url: SITE,
      logo: {
        "@type": "ImageObject",
        url: `${SITE}/marca/monnif-icone.png`,
        width: 512,
        height: 512,
      },
      image: `${SITE}/marca/monnif-icone.png`,
      email: "contato@monnif.com",
      sameAs: PERFIS,
      description:
        "Gestão financeira pessoal e familiar com assistente de IA, contas compartilhadas, cartão de crédito, orçamento e projeção de saldo.",
      areaServed: { "@type": "Country", name: "Brasil" },
      knowsLanguage: "pt-BR",
      founder: CRIADOR,
      parentOrganization: EMPRESA_MAE,
    },
    {
      "@type": "WebSite",
      "@id": ID_SITE,
      name: "Monnif",
      alternateName: "Monnif — finanças da família",
      url: SITE,
      inLanguage: "pt-BR",
      publisher: { "@id": ID_ORG },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#pagina`,
      url: canonical,
      name: title,
      description,
      inLanguage: "pt-BR",
      isPartOf: { "@id": ID_SITE },
      primaryImageOfPage: ogUrl,
    },
  ],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#7f22fe" />

<!-- Antes de qualquer estilo: sem isto a página pinta no tema errado e pisca. -->
<script is:inline>
(function () {
  try {
    var t = localStorage.getItem("monnif-tema");
    if (t === "escuro" || t === "sistema") document.documentElement.dataset.tema = t;
  } catch (e) {
    /* navegação privada em alguns navegadores barra o localStorage */
  }
})();
</script>
<link rel="canonical" href={canonical} />

<!-- Sem os limites explícitos o Google corta o resumo e usa miniatura pequena. -->
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Monnif" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="pt_BR" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={title} />

<link rel="icon" href="/marca/monnif-icone.svg" type="image/svg+xml" />
<link rel="icon" href="/marca/monnif-icone.png" type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href="/marca/monnif-icone.png" />
<link rel="alternate" type="application/rss+xml" title="Blog da Monnif" href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<link rel="preload" href="/fontes/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

<script type="application/ld+json" is:inline set:html={JSON.stringify(grafoBase)} />
<slot name="head" />
</head>
<body>

<a class="skip" href="#top">Pular para o conteúdo</a>

<div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

<Header />

<main id="top">
  <slot />
</main>

<Footer />

<script is:inline>
(function () {
  // Header ganha vidro depois de sair do topo.
  var header = document.getElementById("header");
  var onScroll = function () { header.classList.toggle("stuck", window.scrollY > 12); };
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  // O <details> abre e fecha sozinho; falta só fechar no Esc e no clique fora.
  var menus = document.querySelectorAll("header details");
  var fechar = function (exceto) {
    menus.forEach(function (d) { if (d !== exceto) d.open = false; });
  };
  document.addEventListener("click", function (e) {
    var aberto = null;
    menus.forEach(function (d) { if (d.open && d.contains(e.target)) aberto = d; });
    fechar(aberto);
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") fechar(null); });

  // Tema: o padrão é o claro e não grava atributo nenhum. "sistema" é escolha
  // explícita e vira data-tema, porque é ele quem liga a media query do CSS.
  var raiz = document.documentElement;
  var guardado = "claro";
  try { guardado = localStorage.getItem("monnif-tema") || "claro"; } catch (e) {}

  var sistemas = document.querySelectorAll("[data-tema-sistema]");
  var marcar = function (valor) {
    sistemas.forEach(function (b) { b.setAttribute("aria-pressed", String(valor === "sistema")); });
  };
  marcar(guardado);

  var aplicar = function (valor) {
    if (valor === "claro") delete raiz.dataset.tema;
    else raiz.dataset.tema = valor;
    try { localStorage.setItem("monnif-tema", valor); } catch (e) {}
    marcar(valor);
  };

  document.querySelectorAll("[data-tema-alterna]").forEach(function (b) {
    b.addEventListener("click", function () {
      // Em "sistema" o clique parte do que o sistema está mostrando agora.
      var atual = raiz.dataset.tema || "claro";
      if (atual === "sistema") {
        atual = matchMedia("(prefers-color-scheme: dark)").matches ? "escuro" : "claro";
      }
      aplicar(atual === "escuro" ? "claro" : "escuro");
    });
  });

  sistemas.forEach(function (b) {
    b.addEventListener("click", function () { aplicar("sistema"); });
  });

  var items = document.querySelectorAll(".reveal");
  var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Sem IntersectionObserver (ou com movimento reduzido) tudo já nasce visível.
  if (reduced || !("IntersectionObserver" in window)) {
    items.forEach(function (el) { el.classList.add("in"); });
    return;
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      entry.target.classList.add("in");
      io.unobserve(entry.target); // entrada é uma vez só, não reanima ao rolar de volta
    });
  }, { rootMargin: "0px 0px -12% 0px", threshold: 0.1 });

  items.forEach(function (el) { io.observe(el); });
})();
</script>

<Visita />

</body>
</html>
